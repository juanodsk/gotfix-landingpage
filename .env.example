# Variables de entorno del Centro de Condiciones.
# Se cargan en Vercel → Settings → Environment Variables (ver GUIA_CONFIGURACION.md).
# NUNCA subas un archivo .env con valores reales al repositorio.

# Supabase → Project Settings → Data API (URL) y API Keys (Secret key)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Resend → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Remitente de los correos. Debe ser del dominio verificado en Resend.
RESEND_FROM=GOTFIX <notificaciones@gotfix.co>

# Correo que recibe la copia de cada firma y el aviso de cada PQRS
CORREO_GOTFIX=gotfixco@gmail.com
